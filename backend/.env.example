# Copy thành .env và điền giá trị thật: cp .env.example .env
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_mini
# DB cloud cần TLS thì đặt DB_SSL=true (DB nội bộ để false)
DB_SSL=false

JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-chay-that

# Chỉ dùng khi deploy lên host: tự nạp schema + data mẫu nếu DB còn trống
AUTO_IMPORT_DB=false

# UC16: tìm sách bằng AI. Lấy key tại Google AI Studio (aistudio.google.com/apikey).
# Để trống thì tính năng tự dùng chế độ khớp từ khóa (kém thông minh hơn).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# UC17-UC19: gửi email qua Resend (nhắc hạn, quên mật khẩu, xác thực email).
# Tạo tài khoản + xác thực tên miền tại resend.com, tạo API key rồi dán vào đây.
# Để trống RESEND_API_KEY thì mọi tính năng email tự tắt, hệ thống vẫn chạy bình thường.
RESEND_API_KEY=

# UC02: tra cứu thông tin sách bằng Big Book API (bigbookapi.com, lấy key tại Console).
# Để trống thì tra cứu tự dùng iTunes Search (không cần key) thay thế.
BIGBOOK_API_KEY=
MAIL_FROM=Thư Viện Mini <admin@thuvien.nanioe.me>
# Địa chỉ web công khai dùng trong link email (local dev thì để http://localhost:5173).
APP_BASE_URL=https://thuvien.nanioe.me
